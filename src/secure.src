// machin-secure — KISS security auditor for agent-first use.
// Deterministic regex rules over a filesystem walk. No LLM, no Docker, no agents,
// and — deliberately — no OpenAI/OpenRouter client baked in. The calling agent
// IS the LLM: it reads the JSONL findings with its own model and reasons over
// them directly. The only thing this tool owns is a small persisted verdict
// store (`secure verdict ...`) so the agent's judgment survives across scans,
// the same BYOK split used in ~/ai/grepapi (rules/briefs here, no LLM call;
// the operator's own model completes the reasoning).
// Output: JSONL findings on stdout (one per line). Exit 2 if high/critical, else 0.
// --hart: publish a self-contained HTML report to https://hart.intrane.fr.

type Rule struct {
	id       string
	pattern  string
	severity string
	cwe      string
	message  string
	langs    []string
	literals []string
}

type Finding struct {
	id         string
	rule       string
	file       string
	line       int
	severity   string
	cwe        string
	message    string
	snippet    string
	verdict    string
	ctx_before []string
	ctx_after  []string
}

type Run struct {
	target     string
	started    int
	findings   []Finding
	scanned    int
	skipped    int
	suppressed int
	rules_n    int
}

// verdict record persisted by `secure verdict` — written by the calling agent
// after IT (not this tool) decides a finding is a false positive or confirmed.
type VerdictRec struct {
	id      string
	verdict string
	reason  string
	ts      int
}

// suppression pattern persisted by `secure suppress` — the agent's rule-level
// false-positive memory. When a finding's (rule, file) matches a pattern, the
// finding is suppressed automatically (counted in `suppressed`, not emitted
// unless --show-all). This is the force multiplier: triage a pattern once,
// not 30 individual findings. Like the verdict store, this tool never decides
// to file a pattern itself — the agent does, after seeing repeated false
// positives from the same rule on the same file shape.
type SuppressPattern struct {
	rule    string
	glob    string
	reason  string
	verdict string
	ts      int
}

// a file queued for scanning, and one worker's local (never-shared) tally —
// per machin's data-race rule, only the collector goroutine (main) may ever
// touch the `run` global; workers accumulate into their own WorkerResult and
// hand it over a channel once, after their job queue drains.
type Job struct {
	path string
	lang string
}

type WorkerResult struct {
	findings   []Finding
	scanned    int
	skipped    int
	suppressed int
}

// tool version — surfaced in SARIF tool.driver.version and --help
var version = "0.1.0"

// global run state (structs are pass-by-value in MFL; a global avoids copying)
var run = Run{findings: []Finding{}}
var verdict_map = make(map[string]string)
var patterns = []SuppressPattern{}
var want_show_all = false
var want_pending = false
var context_n = 0
// lang -> applicable rules, built once per distinct lang instead of once per
// file (avoids re-walking all rules for every one of tens of thousands of files)
var lang_rules_cache = make(map[string][]Rule)

// ---- helpers ----

func last_index(s, sub) (n) {
	n = -1
	j := 0
	for j < len(s)-len(sub)+1 {
		if substr(s, j, j+len(sub)) == sub { n = j }
		j = j + 1
	}
}

// ---- lang detection by extension ----

func lang_of(path) (lang) {
	lang = ""
	bi := last_index(path, "/")
	base := substr(path, bi+1, len(path))
	// Dockerfile (no extension)
	if base == "Dockerfile" || has_prefix(base, "Dockerfile.") { lang = "dockerfile" ; return }
	if has_prefix(base, ".env") { lang = "env" ; return }
	// dependency manifests (filename-based, before extension check)
	if base == "requirements.txt" { lang = "requirements" ; return }
	if base == "go.mod" || base == "go.sum" { lang = "gomod" ; return }
	if base == "Gemfile" || base == "Gemfile.lock" { lang = "gemfile" ; return }
	if base == "Pipfile" || base == "Pipfile.lock" { lang = "pipfile" ; return }
	i := last_index(path, ".")
	if i < 0 { return }
	ext := substr(path, i+1, len(path))
	if ext == "py" { lang = "py" ; return }
	if ext == "js" || ext == "cjs" || ext == "mjs" { lang = "js" ; return }
	if ext == "ts" { lang = "ts" ; return }
	if ext == "tsx" { lang = "tsx" ; return }
	if ext == "jsx" { lang = "jsx" ; return }
	if ext == "vue" { lang = "vue" ; return }
	if ext == "go" { lang = "go" ; return }
	if ext == "rs" { lang = "rust" ; return }
	if ext == "c" || ext == "h" { lang = "c" ; return }
	if ext == "cpp" || ext == "cc" || ext == "cxx" || ext == "hpp" || ext == "hh" { lang = "cpp" ; return }
	if ext == "cs" { lang = "cs" ; return }
	if ext == "kt" || ext == "kts" { lang = "kotlin" ; return }
	if ext == "swift" { lang = "swift" ; return }
	if ext == "php" { lang = "php" ; return }
	if ext == "rb" { lang = "rb" ; return }
	if ext == "java" { lang = "java" ; return }
	if ext == "sh" { lang = "sh" ; return }
	if ext == "yml" || ext == "yaml" { lang = "yaml" ; return }
	if ext == "tf" || ext == "tfvars" { lang = "terraform" ; return }
	if ext == "xml" { lang = "xml" ; return }
	if ext == "toml" { lang = "toml" ; return }
	if ext == "properties" { lang = "properties" ; return }
	if ext == "plist" { lang = "plist" ; return }
	if ext == "ini" || ext == "cfg" || ext == "conf" { lang = "ini" ; return }
	if ext == "json" { lang = "json" ; return }
	if ext == "md" { lang = "md" ; return }
	if ext == "sql" { lang = "sql" ; return }
	if ext == "env" { lang = "env" ; return }
	if ext == "html" || ext == "htm" { lang = "html" ; return }
	if ext == "css" { lang = "css" ; return }
}

// ---- dir skip list ----

func should_skip_dir(name) (b) {
	b = false
	skip := []string{".git", "node_modules", ".venv", "venv", "__pycache__", "dist", "build", "coverage", ".next", ".nuxt", ".cache", "vendor", ".idea", ".vscode", "target", "deps", ".hg", ".svn"}
	for _, s := range skip {
		if s == name { b = true ; return }
	}
}

// ---- verdict store (the agent's persisted memory, not this tool's) ----

func default_store_path(target) (path) {
	k, _, _ := stat(target)
	dir := target
	if k == 1 {
		bi := last_index(target, "/")
		dir = "."
		if bi >= 0 { dir = substr(target, 0, bi) }
	}
	path = dir + "/.machin-secure.verdicts.json"
}

func load_verdict_recs(path) (recs) {
	recs = []VerdictRec{}
	s := read_file(path)
	if len(s) == 0 { return }
	recs = parse(s, []VerdictRec{})
}

func load_verdicts(path) {
	recs := load_verdict_recs(path)
	for _, r := range recs { verdict_map[r.id] = r.verdict }
}

func save_verdict(path, id, verdict, reason) {
	recs := load_verdict_recs(path)
	out := []VerdictRec{}
	found := false
	for _, r := range recs {
		if r.id == id {
			r.verdict = verdict
			r.reason = reason
			r.ts = now()
			found = true
		}
		out = append(out, r)
	}
	if !found {
		out = append(out, VerdictRec{id: id, verdict: verdict, reason: reason, ts: now()})
	}
	write_file(path, json(out))
}

// ---- suppression pattern store (rule-level false-positive memory) ----
// Mirrors the verdict store: the agent files a pattern via `secure suppress`,
// and at scan time findings matching (rule, glob) are suppressed automatically.
// The store lives next to the verdict store, gitignored or committed (operator's
// choice — committing shares the team's triage across clones).

func default_patterns_path(target) (path) {
	k, _, _ := stat(target)
	dir := target
	if k == 1 {
		bi := last_index(target, "/")
		dir = "."
		if bi >= 0 { dir = substr(target, 0, bi) }
	}
	path = dir + "/.machin-secure.patterns.json"
}

func load_pattern_recs(path) (recs) {
	recs = []SuppressPattern{}
	s := read_file(path)
	if len(s) == 0 { return }
	recs = parse(s, []SuppressPattern{})
}

func load_patterns(path) {
	patterns = load_pattern_recs(path)
}

func save_pattern(path, rule, glob, reason) {
	recs := load_pattern_recs(path)
	out := []SuppressPattern{}
	found := false
	for _, r := range recs {
		if r.rule == rule && r.glob == glob {
			r.reason = reason
			r.ts = now()
			found = true
		}
		out = append(out, r)
	}
	if !found {
		out = append(out, SuppressPattern{rule: rule, glob: glob, reason: reason, verdict: "drop", ts: now()})
	}
	write_file(path, json(out))
}

// glob_match checks if a file path matches a glob pattern. v1 supports the
// three common cases: suffix (*.vue → has_suffix), prefix (test/** →
// has_prefix on the dir), and exact/contains fallback. No full glob library
// — covers 90% of real suppression patterns without a dependency.
func glob_match(path, glob) (b) {
	b = false
	// *.ext → suffix match on the extension
	if has_prefix(glob, "*.") {
		ext := substr(glob, 1, len(glob))
		if has_suffix(path, ext) { b = true ; return }
		return
	}
	// dir/** → prefix match on dir + "/"
	if has_suffix(glob, "/**") {
		prefix := substr(glob, 0, len(glob)-2)
		if has_prefix(path, prefix) { b = true ; return }
		return
	}
	// **/dir/ → suffix match on dir + "/"
	if has_prefix(glob, "**/") {
		suffix := substr(glob, 2, len(glob))
		if has_suffix(path, suffix) { b = true ; return }
		return
	}
	// exact match or substring fallback
	if path == glob { b = true ; return }
	if contains(path, glob) { b = true ; return }
}

// pattern_suppressed checks if a finding (rule, file) matches any suppression
// pattern. Called in the scan loops before emitting a finding.
func pattern_suppressed(rule, file) (b) {
	b = false
	for _, p := range patterns {
		if p.rule == rule && glob_match(file, p.glob) { b = true ; return }
	}
}

// ---- rule loading ----

func load_rules(path) (rules) {
	rules = []Rule{}
	s := read_file(path)
	if len(s) == 0 { return }
	rules = parse(s, []Rule{})
	// Pre-compute required literal substrings for each rule's pattern. The
	// scan loop uses them as a cheap `contains` pre-filter before the expensive
	// regex_match call — machin's regex_match recompiles the pattern on every
	// call (no compiled-regex cache), so skipping regex calls on large files
	// is a big win. For patterns with top-level alternation (A|B|C), we
	// extract a literal from EACH alternative and only run the regex if the
	// line contains at least one. Rules where no literal can be extracted
	// (char-class prefixes, empty alternatives) get an empty list and always
	// run the regex — safe, just unoptimized.
	for i := range rules {
		rules[i].literals = extract_literals(rules[i].pattern)
	}
}

// extract_literals returns a list of literal substrings for pre-filtering.
// For a pattern without top-level `|`, returns a single-element list (or
// empty if no literal can be extracted). For `A|B|C`, it extracts a literal
// from EACH alternative — but ONLY if every alternative yields a literal.
// If any alternative has no extractable literal (e.g. starts with `(` or a
// char class, or its literal run is <3 chars), the line could match via that
// alternative without containing any of the other literals, so we return an
// empty list and don't pre-filter (safe — the regex always runs).
func extract_literals(pat) (lits) {
	lits = []string{}
	alts := split_top_level_alt(pat)
	all_have := true
	for _, alt := range alts {
		l := extract_literal_one(alt)
		if l == "" {
			all_have = false
		} else {
			lits = append(lits, l)
		}
	}
	if !all_have { lits = []string{} }
}

// split_top_level_alt splits a POSIX ERE pattern by top-level `|` (not inside
// [...] or (...)), returning each alternative as a substring.
func split_top_level_alt(pat) (alts) {
	alts = []string{}
	depth := 0
	start := 0
	i := 0
	n := len(pat)
	for i < n {
		c := substr(pat, i, i+1)
		if c == "\\" { i = i + 2 ; continue }
		if c == "[" {
			i = i + 1
			if i < n && substr(pat, i, i+1) == "^" { i = i + 1 }
			if i < n && substr(pat, i, i+1) == "]" { i = i + 1 }
			while i < n && substr(pat, i, i+1) != "]" { i = i + 1 }
			if i < n { i = i + 1 }
			continue
		}
		if c == "(" { depth = depth + 1 }
		if c == ")" { depth = depth - 1 }
		if c == "|" && depth == 0 {
			alts = append(alts, substr(pat, start, i))
			start = i + 1
		}
		i = i + 1
	}
	alts = append(alts, substr(pat, start, n))
}

// extract_literal_one pulls a leading literal substring (≥3 chars) from a
// single ERE alternative (no top-level `|`). Conservative: only chars we're
// certain are required are collected; `*`/`?` drops the optional preceding
// char and stops.
func extract_literal_one(pat) (lit) {
	lit = ""
	i := 0
	n := len(pat)
	if i < n && substr(pat, i, i+1) == "^" { i = i + 1 }
	// skip leading zero-width assertions and whitespace quantifiers
	while i < n {
		if substr(pat, i, i+1) == "\\" && i+1 < n {
			nx := substr(pat, i+1, i+2)
			if nx == "b" || nx == "B" { i = i + 2 ; continue }
			if nx == "s" || nx == "S" || nx == "t" {
				i = i + 2
				if i < n && (substr(pat, i, i+1) == "*" || substr(pat, i, i+1) == "+") { i = i + 1 }
				continue
			}
		}
		break
	}
	out := ""
	while i < n {
		c := substr(pat, i, i+1)
		if c == "\\" {
			if i+1 < n {
				nx := substr(pat, i+1, i+2)
				if nx == "b" || nx == "B" || nx == "d" || nx == "D" || nx == "s" || nx == "S" || nx == "w" || nx == "W" || nx == "n" || nx == "r" || nx == "t" { break }
				out = out + nx
				i = i + 2
				continue
			}
			break
		}
		if c == "*" || c == "?" {
			if len(out) > 0 { out = substr(out, 0, len(out)-1) }
			break
		}
		if c == "+" || c == "{" || c == "[" || c == "(" || c == ")" || c == "|" || c == "." || c == "$" || c == "]" || c == "}" { break }
		out = out + c
		i = i + 1
	}
	if len(out) >= 3 { lit = out }
}

// ---- rule applies to lang? ----

func rule_applies(rule, lang) (b) {
	b = false
	for _, rl := range rule.langs {
		if rl == "*" { b = true ; return }
		if rl == lang { b = true ; return }
	}
}

// ---- file scan ----

// pre-filter rules to those applicable to a lang, cached: with tens of
// thousands of files but only a dozen or so distinct langs, this turns
// O(files x rules) filtering into O(distinct-langs x rules).
func rules_for_lang(rules, lang) (out) {
	if has(lang_rules_cache, lang) { out = lang_rules_cache[lang] ; return }
	out = []Rule{}
	for _, rule := range rules {
		if rule_applies(rule, lang) { out = append(out, rule) }
	}
	lang_rules_cache[lang] = out
}

// context_lines extracts up to N lines before and after index i from lines,
// for the --context flag. Returns empty slices when context_n is 0.
func context_before(lines, i, n) (out) {
	out = []string{}
	if n == 0 { return }
	start := i - n
	if start < 0 { start = 0 }
	j := start
	for j < i {
		out = append(out, lines[j])
		j = j + 1
	}
}

func context_after(lines, i, n) (out) {
	out = []string{}
	if n == 0 { return }
	end := i + n + 1
	if end > len(lines) { end = len(lines) }
	j := i + 1
	for j < end {
		out = append(out, lines[j])
		j = j + 1
	}
}

func scan_file(path, lang, rules) {
	run.scanned = run.scanned + 1
	src := read_file(path)
	if len(src) == 0 { return }
	if len(src) > 1000000 { run.skipped = run.skipped + 1 ; return }
	applicable := rules_for_lang(rules, lang)
	if len(applicable) == 0 { return }
	lines := split(src, "\n")
	for i, line := range lines {
		trimmed := trim(line)
		if trimmed == "" { continue }
		for _, rule := range applicable {
			if len(rule.literals) > 0 {
				hit := false
				for _, lit := range rule.literals {
					if contains(line, lit) { hit = true ; break }
				}
				if !hit { continue }
			}
			if regex_match(line, rule.pattern) {
				id := sha256(rule.id + "|" + path + "|" + trimmed)
				v := verdict_map[id]
				if v == "drop" {
					run.suppressed = run.suppressed + 1
					if !want_show_all { continue }
				}
				// rule-level suppression pattern: (rule, file) match → suppress
				if pattern_suppressed(rule.id, path) {
					run.suppressed = run.suppressed + 1
					if !want_show_all { continue }
				}
				snip := trimmed
				if len(snip) > 200 { snip = substr(snip, 0, 200) + "..." }
				f := Finding{
					id:         id,
					rule:       rule.id,
					file:       path,
					line:       i + 1,
					severity:   rule.severity,
					cwe:        rule.cwe,
					message:    rule.message,
					snippet:    snip,
					verdict:    v,
					ctx_before: context_before(lines, i, context_n),
					ctx_after:  context_after(lines, i, context_n),
				}
				run.findings = append(run.findings, f)
			}
		}
	}
}

// ---- diff mode: scan only git-changed files, for fast CI/pre-commit checks ----
// `--diff` alone: working-tree changes vs HEAD (local dev, pre-commit).
// `--diff-base <ref>`: changes vs a base branch/commit (CI, PR diff), using
// git's triple-dot (merge-base) form so unrelated upstream commits on the
// base don't show up as "changed".

func diff_scan(target, base, rules) {
	cmd := "git -C " + target + " diff --name-only"
	if base != "" { cmd = cmd + " " + base + "...HEAD" }
	code, out, errout := exec(cmd)
	if code != 0 {
		println("{\"error\":\"git diff failed: " + trim(errout) + "\"}")
		exit(1)
	}
	paths := split(out, "\n")
	for _, p := range paths {
		rel := trim(p)
		if rel == "" { continue }
		full := target + "/" + rel
		k, size, _ := stat(full)
		if k != 1 { continue }  // deleted/renamed-away files won't stat as a file
		if has_suffix(rel, ".machin-secure.verdicts.json") { continue }
		if size > 1000000 { run.skipped = run.skipped + 1 ; continue }
		lang := lang_of(full)
		if lang == "" { continue }
		scan_file(full, lang, rules)
	}
}

// ---- recursive walk: collect jobs, then scan them in parallel ----
// Walking (list_dir/stat) is cheap and stays single-threaded; the expensive
// part — reading each file and running every applicable regex over every
// line — is what gets spread across worker goroutines below.

func collect_files(dir, depth) (jobs) {
	jobs = []Job{}
	if depth > 25 { return }
	entries := list_dir(dir)
	for _, name := range entries {
		full := dir + "/" + name
		k, size, _ := stat(full)
		if k == 2 {
			if should_skip_dir(name) { continue }
			sub := collect_files(full, depth+1)
			for _, j := range sub { jobs = append(jobs, j) }
		} else if k == 1 {
			if has_suffix(name, ".machin-secure.verdicts.json") { continue }
			if size > 1000000 { run.skipped = run.skipped + 1 ; continue }
			lang := lang_of(full)
			if lang == "" { continue }
			jobs = append(jobs, Job{path: full, lang: lang})
		}
	}
}

// every lang lang_of() can return; precomputing all of them once (instead of
// lazily per-file, per the old lang_rules_cache global) means no worker ever
// writes to a shared map — each just reads its own entry, which is race-free.
func all_langs() (langs) {
	langs = []string{"py", "js", "ts", "tsx", "jsx", "vue", "go", "rust", "c", "cpp", "cs", "kotlin", "swift", "php", "rb", "java", "sh", "yaml", "terraform", "xml", "toml", "properties", "plist", "ini", "requirements", "gomod", "gemfile", "pipfile", "json", "env", "md", "dockerfile", "sql", "html", "css"}
}

func build_lang_rules_index(rules) (idx) {
	idx = make(map[string][]Rule)
	for _, l := range all_langs() {
		out := []Rule{}
		for _, rule := range rules {
			if rule_applies(rule, l) { out = append(out, rule) }
		}
		idx[l] = out
	}
}

// scan_into is scan_file's logic against a WORKER-LOCAL result instead of
// the `run` global — safe to call from any number of goroutines at once
// because it never touches shared mutable state (lang_rules is a read-only
// map built before any worker starts; verdict_map/want_show_all are globals
// populated/set before spawning and never written again during a scan).
func scan_into(path, lang, lang_rules, wr_in) (wr) {
	wr = wr_in
	wr.scanned = wr.scanned + 1
	src := read_file(path)
	if len(src) == 0 { return }
	if len(src) > 1000000 { wr.skipped = wr.skipped + 1 ; return }
	applicable := lang_rules[lang]
	if len(applicable) == 0 { return }
	lines := split(src, "\n")
	for i, line := range lines {
		trimmed := trim(line)
		if trimmed == "" { continue }
		for _, rule := range applicable {
			if len(rule.literals) > 0 {
				hit := false
				for _, lit := range rule.literals {
					if contains(line, lit) { hit = true ; break }
				}
				if !hit { continue }
			}
			if regex_match(line, rule.pattern) {
				id := sha256(rule.id + "|" + path + "|" + trimmed)
				v := verdict_map[id]
				if v == "drop" {
					wr.suppressed = wr.suppressed + 1
					if !want_show_all { continue }
				}
				// rule-level suppression pattern: (rule, file) match → suppress
				if pattern_suppressed(rule.id, path) {
					wr.suppressed = wr.suppressed + 1
					if !want_show_all { continue }
				}
				snip := trimmed
				if len(snip) > 200 { snip = substr(snip, 0, 200) + "..." }
				f := Finding{
					id:         id,
					rule:       rule.id,
					file:       path,
					line:       i + 1,
					severity:   rule.severity,
					cwe:        rule.cwe,
					message:    rule.message,
					snippet:    snip,
					verdict:    v,
					ctx_before: context_before(lines, i, context_n),
					ctx_after:  context_after(lines, i, context_n),
				}
				wr.findings = append(wr.findings, f)
			}
		}
	}
}

func scan_worker(jobs, lang_rules, results) {
	wr := WorkerResult{findings: []Finding{}}
	for job := range jobs {
		wr = scan_into(job.path, job.lang, lang_rules, wr)
	}
	results <- wr
}

func parallel_walk(target, rules, workers) {
	jobs_list := collect_files(target, 0)
	n := len(jobs_list)
	if n == 0 { return }
	if workers > n { workers = n }
	if workers < 1 { workers = 1 }
	lang_rules := build_lang_rules_index(rules)

	jobs := make(chan Job)
	results := make(chan WorkerResult)
	w := 0
	for w < workers { go scan_worker(jobs, lang_rules, results) ; w = w + 1 }
	i := 0
	for i < n { jobs <- jobs_list[i] ; i = i + 1 }
	close(jobs)

	got := 0
	for got < workers {
		wr := <-results
		for _, f := range wr.findings { run.findings = append(run.findings, f) }
		run.scanned = run.scanned + wr.scanned
		run.skipped = run.skipped + wr.skipped
		run.suppressed = run.suppressed + wr.suppressed
		got = got + 1
	}
}

// ---- output ----

func emit_jsonl() {
	// When --context is 0, ctx_before/ctx_after are empty arrays. Strip the
	// constant suffix to preserve the pre-context output format (byte-identical
	// findings). When --context N is set, the arrays are populated and the
	// suffix differs, so the replace is a no-op and the full output is kept.
	strip := ",\"ctx_before\":[],\"ctx_after\":[]"
	for _, f := range run.findings {
		// --pending: only unreviewed findings (verdict == ""). Excludes both
		// "keep" (reviewed, confirmed) and "drop" (suppressed).
		if want_pending && f.verdict != "" { continue }
		s := json(f)
		if context_n == 0 { s = replace(s, strip, "") }
		println(s)
	}
}

func emit_summary() {
	crit := 0 ; high := 0 ; med := 0 ; low := 0
	for _, f := range run.findings {
		// --pending: only count unreviewed findings in the severity breakdown.
		if want_pending && f.verdict != "" { continue }
		if f.severity == "critical" { crit = crit + 1 }
		if f.severity == "high" { high = high + 1 }
		if f.severity == "medium" { med = med + 1 }
		if f.severity == "low" { low = low + 1 }
	}
	m := make(map[string]int)
	m["critical"] = crit
	m["high"] = high
	m["medium"] = med
	m["low"] = low
	m["total"] = crit + high + med + low
	m["scanned"] = run.scanned
	m["skipped"] = run.skipped
	m["suppressed"] = run.suppressed
	m["rules"] = run.rules_n
	println(json(m))
}

// ---- SARIF 2.1.0 output (for GitHub Code Scanning / SARIF consumers) ----
// Built as a string with json() escaping each value: MFL has no `any` map
// value type, so nested heterogeneous JSON is assembled by concatenation;
// json(x) on each string/int yields a correctly escaped JSON token, so no
// hand-rolled escaping. This is the bridge to CI: GitHub's Security tab,
// VS Code SARIF viewer, and any SARIF-consuming tool read this directly.

func sarif_level(sev) (lvl) {
	lvl = "note"
	if sev == "critical" { lvl = "error" }
	if sev == "high" { lvl = "error" }
	if sev == "medium" { lvl = "warning" }
	if sev == "low" { lvl = "note" }
}

// GitHub security-severity (0.0-10.0) drives prioritization in the Security tab
func sarif_sec_severity(sev) (s) {
	s = "2.0"
	if sev == "critical" { s = "9.5" }
	if sev == "high" { s = "8.0" }
	if sev == "medium" { s = "5.0" }
}

func cwe_url(cwe) (url) {
	url = ""
	if has_prefix(cwe, "CWE-") {
		num := substr(cwe, 4, len(cwe))
		url = "https://cwe.mitre.org/data/definitions/" + num + ".html"
	}
}

func emit_sarif(rules) {
	rule_idx := make(map[string]int)
	rules_arr := ""
	for i, rule := range rules {
		rule_idx[rule.id] = i
		if i > 0 { rules_arr = rules_arr + "," }
		tags := "[\"security\""
		if rule.cwe != "" { tags = tags + "," + json(to_lower(rule.cwe)) }
		tags = tags + "]"
		rules_arr = rules_arr + "{\"id\":" + json(rule.id)
		rules_arr = rules_arr + ",\"name\":" + json(rule.id)
		rules_arr = rules_arr + ",\"shortDescription\":{\"text\":" + json(rule.message) + "}"
		cu := cwe_url(rule.cwe)
		if cu != "" { rules_arr = rules_arr + ",\"helpUri\":" + json(cu) }
		rules_arr = rules_arr + ",\"defaultConfiguration\":{\"level\":" + json(sarif_level(rule.severity)) + "}"
		rules_arr = rules_arr + ",\"properties\":{\"tags\":" + tags
		rules_arr = rules_arr + ",\"security-severity\":" + json(sarif_sec_severity(rule.severity)) + "}}"
	}
	results_arr := ""
	first := true
	for _, f := range run.findings {
		// --pending: only unreviewed findings (verdict == "").
		if want_pending && f.verdict != "" { continue }
		if !first { results_arr = results_arr + "," }
		first = false
		idx := rule_idx[f.rule]
		results_arr = results_arr + "{\"ruleId\":" + json(f.rule)
		results_arr = results_arr + ",\"ruleIndex\":" + str(idx)
		results_arr = results_arr + ",\"level\":" + json(sarif_level(f.severity))
		results_arr = results_arr + ",\"message\":{\"text\":" + json(f.message) + "}"
		results_arr = results_arr + ",\"locations\":[{\"physicalLocation\":{\"artifactLocation\":{\"uri\":" + json(f.file)
		results_arr = results_arr + "},\"region\":{\"startLine\":" + str(f.line) + ",\"snippet\":{\"text\":" + json(f.snippet) + "}}}}]"
		results_arr = results_arr + ",\"partialFingerprints\":{\"primary\":" + json(f.id) + "}}"
	}
	out := "{\"$schema\":\"https://json.schemastore.org/sarif-2.1.0.json\",\"version\":\"2.1.0\",\"runs\":[{\"tool\":{\"driver\":{\"name\":\"machin-secure\",\"version\":\"" + version + "\",\"informationUri\":\"https://github.com/javimosch/machin-secure\",\"rules\":[" + rules_arr + "]}},\"results\":[" + results_arr + "]}]}"
	println(out)
}

// ---- hart reporting (opt-in) ----
// This tool deliberately does NOT author the report itself — that would bake
// another piece of "LLM-flavored" judgment (what to highlight, how to phrase
// it) into a binary that otherwise owns none. Same rule as the verdict store:
// the calling agent already has a model; authoring prose/HTML is its job.
// --hart only prints a hint pointing the agent at the default hart instance
// and the exact publish contract, so it can write and publish its own report.

func print_hart_hint(owner, artifact) {
	hart_url := env("HART_URL")
	if hart_url == "" { hart_url = "https://hart.intrane.fr" }
	crit := 0 ; high := 0 ; med := 0 ; low := 0
	for _, f := range run.findings {
		if f.severity == "critical" { crit = crit + 1 }
		if f.severity == "high" { high = high + 1 }
		if f.severity == "medium" { med = med + 1 }
		if f.severity == "low" { low = low + 1 }
	}
	hint := "Write a self-contained HTML report of these findings (target="
	hint = hint + run.target + ", " + str(crit) + " critical, " + str(high) + " high, "
	hint = hint + str(med) + " medium, " + str(low) + " low) and publish it yourself: "
	hint = hint + "HART_URL=" + hart_url + " hart publish <file.html> --owner " + owner
	hint = hint + " --artifact " + artifact + " --visibility unlisted"
	m := make(map[string]string)
	m["hart_hint"] = hint
	m["hart_url"] = hart_url
	m["hart_guide"] = hart_url + "/llms.txt"
	m["note"] = "machin-secure does not generate or publish reports itself; this is guidance for the calling agent's own model"
	println(json(m))
}

// ---- verdict subcommand ----
// `secure verdict` never reasons about a finding itself — it only persists a
// verdict the calling agent already decided. The agent is the LLM here; this
// tool has no model client, no API key, no network call to any LLM provider.

func print_verdict_help() {
	println("usage: secure verdict --target PATH <id> <keep|drop> [--reason TEXT]")
	println("       secure verdict --target PATH --stdin")
	println("")
	println("Persists the CALLING AGENT's own judgment about a finding id (from the")
	println("\"id\" field of a JSONL finding), so a future scan of the same target")
	println("suppresses it (verdict=drop) or marks it reviewed (verdict=keep).")
	println("This tool never calls an LLM to decide this itself.")
	println("")
	println("--stdin reads JSON Lines of {\"id\":...,\"verdict\":\"keep\"|\"drop\",\"reason\":...}")
	println("for batch review after the agent has read a scan's output.")
	println("")
	println("store: <target-dir>/.machin-secure.verdicts.json (override with --store PATH)")
}

func cmd_verdict(a) {
	target := "."
	store_path := ""
	use_stdin := false
	id := ""
	verdict := ""
	reason := ""
	help := false

	i := 2
	for i < len(a) {
		arg := a[i]
		if arg == "--target" { i = i + 1 ; if i < len(a) { target = a[i] } }
		if arg == "--store" { i = i + 1 ; if i < len(a) { store_path = a[i] } }
		if arg == "--reason" { i = i + 1 ; if i < len(a) { reason = a[i] } }
		if arg == "--stdin" { use_stdin = true }
		if arg == "--help" || arg == "-h" { help = true }
		if !has_prefix(arg, "-") {
			if id == "" { id = arg } else if verdict == "" { verdict = arg }
		}
		i = i + 1
	}

	if help {
		print_verdict_help()
		return
	}

	if store_path == "" { store_path = default_store_path(target) }

	if use_stdin {
		s := read_stdin()
		lines := split(s, "\n")
		n := 0
		for _, line := range lines {
			t := trim(line)
			if t == "" { continue }
			rec := parse(t, VerdictRec{})
			if rec.id == "" || rec.verdict == "" { continue }
			save_verdict(store_path, rec.id, rec.verdict, rec.reason)
			n = n + 1
		}
		println("{\"stored\":" + str(n) + ",\"store\":\"" + store_path + "\"}")
		exit(0)
	}

	if id == "" || verdict == "" {
		println("{\"error\":\"usage: secure verdict --target PATH <id> <keep|drop> [--reason TEXT]\"}")
		exit(1)
	}
	if verdict != "keep" && verdict != "drop" {
		println("{\"error\":\"verdict must be 'keep' or 'drop'\"}")
		exit(1)
	}
	save_verdict(store_path, id, verdict, reason)
	println("{\"stored\":1,\"id\":\"" + id + "\",\"verdict\":\"" + verdict + "\",\"store\":\"" + store_path + "\"}")
	exit(0)
}

// ---- `secure suppress` subcommand ----
// Persists a rule-level suppression pattern. At scan time, findings matching
// (rule, glob) are suppressed automatically. This is the force multiplier:
// triage a pattern once, not 30 individual findings. Like `secure verdict`,
// this tool never decides to file a pattern itself — the agent does, after
// seeing repeated false positives from the same rule on the same file shape.

func print_suppress_help() {
	println("usage: secure suppress --target PATH --rule RULE --glob GLOB [--reason TEXT]")
	println("       secure suppress --target PATH --stdin")
	println("")
	println("Persists a rule-level suppression pattern. At scan time, findings where")
	println("the rule matches AND the file path matches the glob are suppressed")
	println("(counted in `suppressed`, not emitted unless --show-all).")
	println("")
	println("This is the force multiplier: instead of dropping 30 individual findings")
	println("from the same rule on *.vue files, file one pattern and they stay dropped.")
	println("This tool never calls an LLM to decide this — the agent files the pattern")
	println("after seeing repeated false positives.")
	println("")
	println("glob patterns supported (v1, no full glob library):")
	println("  *.ext          suffix match (e.g. *.vue, *.test.js)")
	println("  dir/**         prefix match (e.g. test/**, vendor/**)")
	println("  **/dir/        suffix match (e.g. **/fixtures/)")
	println("  other          exact match or substring fallback")
	println("")
	println("--stdin reads JSON Lines of {\"rule\":...,\"glob\":...,\"reason\":...}")
	println("for batch filing after the agent has identified repeated false positives.")
	println("")
	println("store: <target-dir>/.machin-secure.patterns.json (override with --patterns-store PATH)")
}

func cmd_suppress(a) {
	target := "."
	store_path := ""
	use_stdin := false
	rule := ""
	glob := ""
	reason := ""
	help := false

	i := 2
	for i < len(a) {
		arg := a[i]
		if arg == "--target" { i = i + 1 ; if i < len(a) { target = a[i] } }
		if arg == "--patterns-store" { i = i + 1 ; if i < len(a) { store_path = a[i] } }
		if arg == "--rule" { i = i + 1 ; if i < len(a) { rule = a[i] } }
		if arg == "--glob" { i = i + 1 ; if i < len(a) { glob = a[i] } }
		if arg == "--reason" { i = i + 1 ; if i < len(a) { reason = a[i] } }
		if arg == "--stdin" { use_stdin = true }
		if arg == "--help" || arg == "-h" { help = true }
		i = i + 1
	}

	if help {
		print_suppress_help()
		return
	}

	if store_path == "" { store_path = default_patterns_path(target) }

	if use_stdin {
		s := read_stdin()
		lines := split(s, "\n")
		n := 0
		for _, line := range lines {
			t := trim(line)
			if t == "" { continue }
			rec := parse(t, SuppressPattern{})
			if rec.rule == "" || rec.glob == "" { continue }
			save_pattern(store_path, rec.rule, rec.glob, rec.reason)
			n = n + 1
		}
		println("{\"stored\":" + str(n) + ",\"store\":\"" + store_path + "\"}")
		exit(0)
	}

	if rule == "" || glob == "" {
		println("{\"error\":\"usage: secure suppress --target PATH --rule RULE --glob GLOB [--reason TEXT]\"}")
		exit(1)
	}
	save_pattern(store_path, rule, glob, reason)
	println("{\"stored\":1,\"rule\":\"" + rule + "\",\"glob\":\"" + glob + "\",\"store\":\"" + store_path + "\"}")
	exit(0)
}

// ---- `secure guide` subcommand (cli-guide-spec v1.0) ----
// The embedded mental model: model, loop, concepts, commands, examples, gotchas.
// JSON by default (agent-first); --human for readable markdown. Embedded in the
// binary — no network fetch. A pure-CLI tool conforms without HTTP endpoints.

func guide_json() (g) {
	g = "{"
	g = g + "\"machin-secure\":\"a free, deterministic, agent-first security scanner (1000 rules, 25 languages, SARIF to GitHub)\","
	g = g + "\"one_liner\":\"A regex-based SAST that runs in your CI on every push for free — no per-developer seat tax, no LLM API calls, your code never leaves your runner. The scan loop is deterministic; the judgment (triage, false-positive suppression) is BYOK — your agent or your engineer decides, and the tool persists the verdict.\","
	g = g + "\"model\":{"
	g = g + "\"split\":\"DETERMINISTIC SCAN LOOP (regex rules, no API calls, free, every push) / BYOK JUDGMENT (your agent or engineer triages findings, files verdicts and suppression patterns that persist across scans). The tool never calls an LLM — the CLI is the agent interface.\","
	g = g + "\"byok_llm\":\"the operator IS the LLM. secure emits structured findings (JSONL); YOUR agent reads them, judges them, and writes back verdicts via `secure verdict` / `secure suppress`. No API key, no token billing, no network call to a model provider.\","
	g = g + "\"no_server\":\"pure CLI — no server, no database, no index. The filesystem is scanned fresh every time. The only state that persists is the verdict store and the patterns store (the agent's own memory, not a cache the tool invents).\","
	g = g + "\"sarif\":\"--sarif emits a SARIF 2.1.0 report for GitHub Code Scanning / the Security tab. JSONL is the default for agent consumption; SARIF is for CI integration.\"},"
	g = g + "\"loop\":["
	g = g + "\"secure --target . --diff-base origin/main --pending --context 3  # scan changed files, only unreviewed findings, with ±3 lines of context\","
	g = g + "\"# agent reads the findings JSONL, applies judgment (keep/drop/suppress pattern)\","
	g = g + "\"secure verdict --stdin < batch_of_keep_drop.jsonl               # persist individual verdicts\","
	g = g + "\"secure suppress --rule X --glob '*.vue' --reason 'Vue prop bindings'  # persist a pattern for repeated false positives\","
	g = g + "\"# next scan: --pending shows only genuinely new findings — suppressed ones stay suppressed\","
	g = g + "\"# for CI: secure --sarif --diff-base origin/main > results.sarif && upload to GitHub Security tab\"],"
	g = g + "\"concepts\":{"
	g = g + "\"finding\":\"a JSONL object: {id, rule, file, line, severity, cwe, message, snippet, verdict, ctx_before, ctx_after}. The id is a stable SHA-256 of (rule|file|trimmed_line) — pass it to `secure verdict`.\","
	g = g + "\"verdict\":\"the agent's judgment on a specific finding id: 'keep' (confirmed real) or 'drop' (false positive). Dropped findings are suppressed in future scans. Stored in .machin-secure.verdicts.json.\","
	g = g + "\"suppress_pattern\":\"a rule-level false-positive filter: (rule, glob) → suppress. Instead of dropping 30 individual findings from the same rule on *.vue files, file one pattern and they stay dropped. Stored in .machin-secure.patterns.json.\","
	g = g + "\"pending\":\"--pending emits only unreviewed findings (verdict == \\\"\\\"), excluding both keep and drop. The agent's work queue — what's new since last triage.\","
	g = g + "\"context\":\"--context N emits ±N lines of code around each finding as ctx_before/ctx_after arrays, so the agent can triage without a read_file round-trip per finding.\","
	g = g + "\"diff_base\":\"--diff-base REF scans only files changed vs REF (git diff --name-only REF...HEAD). For CI/PR-scoped scans — fast feedback on what changed.\","
	g = g + "\"literal_prefilter\":\"each rule has a required literal substring extracted at load time; the scan loop does a cheap contains() before the expensive regex_match. 5.8x speedup on large files, byte-identical findings.\"},"
	g = g + "\"commands\":{"
	g = g + "\"scan\":[\"secure --target . [--rules rules.json]\",\"secure --target . --diff-base origin/main\",\"secure --target . --pending --context 3\",\"secure --target . --sarif > results.sarif\",\"secure --target . --summary\"],"
	g = g + "\"verdict\":[\"secure verdict --target . <id> <keep|drop> [--reason TEXT]\",\"secure verdict --target . --stdin < batch.jsonl\"],"
	g = g + "\"suppress\":[\"secure suppress --target . --rule RULE --glob GLOB [--reason TEXT]\",\"secure suppress --target . --stdin < batch.jsonl\"],"
	g = g + "\"introspection\":[\"secure guide\",\"secure guide --human\",\"secure --help\",\"secure feedback \\\"<message>\\\" [--kind bug|idea|praise|note]\"]},"
	g = g + "\"examples\":["
	g = g + "{\"goal\":\"scan a PR for new findings\",\"do\":[\"secure --target . --diff-base origin/main --pending --context 3\",\"# agent triages the findings\",\"secure verdict --stdin < keep_drop_batch.jsonl\"]},"
	g = g + "{\"goal\":\"suppress repeated false positives from one rule\",\"do\":[\"secure suppress --target . --rule js-hardcoded-secret --glob '*.vue' --reason 'Vue prop bindings, not secrets'\",\"secure --target . --pending  # those findings no longer appear\"]},"
	g = g + "{\"goal\":\"CI: SARIF to GitHub Security tab\",\"do\":[\"secure --target . --diff-base origin/main --sarif > results.sarif\",\"# upload results.sarif via github/codeql-action/upload-sarif\"]},"
	g = g + "{\"goal\":\"full audit of a repo\",\"do\":[\"secure --target . --context 3  # all findings, with code context\",\"secure --target . --summary  # just the counts\"]}],"
	g = g + "\"gotchas\":["
	g = g + "\"POSIX ERE only — no PCRE features like (?!...) lookahead; they silently no-op\","
	g = g + "\"\\\\d is NOT supported in POSIX ERE (silently fails to match) — use [0-9] instead; \\\\b, \\\\s, \\\\w DO work\","
	g = g + "\"the tool never calls an LLM — the agent does all triage; the CLI is the agent interface (grepapi split)\","
	g = g + "\"verdicts and patterns are per-repo (.machin-secure.verdicts.json / .machin-secure.patterns.json) — commit them to share triage across the team\","
	g = g + "\"--pending takes precedence over --show-all (even with show-all, pending excludes reviewed findings)\","
	g = g + "\"exit codes: 0 = clean, 1 = error, 2 = high/critical findings present\","
	g = g + "\"stdout = data (JSONL/SARIF/summary), stderr = nothing or logs — pipe-friendly\","
	g = g + "\"the scan loop is regex SAST, not taint tracking — use CodeQL for data-flow analysis (it's free for public repos)\"],"
	g = g + "\"version\":\"" + version + "\","
	g = g + "\"see_also\":[\"secure --help\",\"secure feedback --help\"]"
	g = g + "}"
}

func guide_human() (h) {
	h = "# machin-secure — agent-first security scanner\n\n"
	h = h + "A free, deterministic, regex-based SAST: 1000 rules, 25 languages, SARIF to GitHub.\n"
	h = h + "The scan loop is deterministic and free; the judgment is BYOK — your agent decides.\n\n"
	h = h + "## The model\n\n"
	h = h + "- **Deterministic scan loop**: regex rules, no API calls, runs in CI on every push for free.\n"
	h = h + "- **BYOK judgment**: your agent or engineer triages findings, files verdicts and suppression\n"
	h = h + "  patterns that persist across scans. The tool never calls an LLM.\n"
	h = h + "- **No server**: pure CLI, no database, no index. Filesystem scanned fresh every time.\n"
	h = h + "- **SARIF**: --sarif for GitHub Code Scanning; JSONL (default) for agent consumption.\n\n"
	h = h + "## The loop\n\n"
	h = h + "1. `secure --target . --diff-base origin/main --pending --context 3`\n"
	h = h + "   → only new findings in changed files, each with ±3 lines of context\n"
	h = h + "2. agent reads findings, applies judgment (keep/drop/suppress pattern)\n"
	h = h + "3. `secure verdict --stdin < batch.jsonl` → persist individual verdicts\n"
	h = h + "4. `secure suppress --rule X --glob '*.vue' --reason '...'` → persist a pattern\n"
	h = h + "5. next scan: --pending shows only genuinely new findings\n\n"
	h = h + "## Commands\n\n"
	h = h + "- `secure --target . [flags]` — scan (JSONL by default)\n"
	h = h + "- `secure verdict <id> <keep|drop>` — persist a finding verdict\n"
	h = h + "- `secure suppress --rule R --glob G` — persist a suppression pattern\n"
	h = h + "- `secure guide [--human]` — this guide\n"
	h = h + "- `secure feedback \"<message>\"` — send feedback to the maintainer\n\n"
	h = h + "## Key flags\n\n"
	h = h + "- `--pending` — only unreviewed findings (verdict == \"\")\n"
	h = h + "- `--context N` — ±N lines of code around each finding\n"
	h = h + "- `--diff-base REF` — scan only files changed vs REF\n"
	h = h + "- `--sarif` — SARIF 2.1.0 output for GitHub Security tab\n"
	h = h + "- `--show-all` — include suppressed findings\n\n"
	h = h + "## Gotchas\n\n"
	h = h + "- POSIX ERE only — no `(?!...)` lookahead, no `\\d` (use `[0-9]`)\n"
	h = h + "- The tool never calls an LLM — the agent does all triage\n"
	h = h + "- Verdicts/patterns are per-repo — commit them to share across the team\n"
	h = h + "- Exit codes: 0 = clean, 1 = error, 2 = high/critical findings present\n"
	h = h + "- Regex SAST, not taint tracking — use CodeQL for data-flow analysis\n\n"
	h = h + "Version: " + version + "\n"
}

func cmd_guide(a) {
	want_human := false
	help := false
	i := 2
	for i < len(a) {
		arg := a[i]
		if arg == "--human" { want_human = true }
		if arg == "--help" || arg == "-h" { help = true }
		i = i + 1
	}
	if help {
		println("usage: secure guide [--human]")
		println("")
		println("Prints the embedded agent skill: the model, the loop, concepts, commands,")
		println("examples, and gotchas. JSON by default (agent-first); --human for readable")
		println("markdown. Embedded in the binary — no network fetch.")
		println("")
		println("An agent that lands on a fresh machine with only the binary reads this once")
		println("and drives the tool with no external docs. This is the mental model that")
		println("--help (the command catalog) cannot be.")
		return
	}
	if want_human {
		println(guide_human())
	} else {
		println(guide_json())
	}
}

// ---- `secure feedback` subcommand (cli-feedback-spec v1.0) ----
// Relay-only adoption (like remotecmd): best-effort POST to the central relay
// (feedback.intrane.fr), tagged app=machin-secure. Never fails the caller.
// FEEDBACK_RELAY=off disables. Idempotent on client-generated id.

func cmd_feedback(a) {
	msg := ""
	kind := "note"
	ctx := ""
	help := false

	i := 2
	for i < len(a) {
		arg := a[i]
		if arg == "--kind" { i = i + 1 ; if i < len(a) { kind = a[i] } }
		if arg == "--context" { i = i + 1 ; if i < len(a) { ctx = a[i] } }
		if arg == "--help" || arg == "-h" { help = true }
		if !has_prefix(arg, "-") && msg == "" { msg = arg }
		i = i + 1
	}

	if help {
		println("usage: secure feedback \"<message>\" [--kind bug|idea|praise|note] [--context \"<what you were doing>\"]")
		println("")
		println("Sends feedback to the central relay (feedback.intrane.fr), tagged")
		println("app=machin-secure. Best-effort — never fails the caller. The relay")
		println("is open for submission, admin-gated for reading.")
		println("")
		println("FEEDBACK_RELAY=off disables the relay write.")
		println("")
		println("This is a relay-only adoption (machin-secure has no local feedback endpoint).")
		return
	}

	if msg == "" {
		println("{\"ok\":false,\"error\":\"usage: secure feedback \\\"<message>\\\" [--kind bug|idea|praise|note] [--context TEXT]\"}")
		exit(1)
	}

	// client-generated idempotency key: 8 random bytes hex-encoded
	id := to_hex(rand_bytes(8))

	reporter := env("USER")
	if reporter == "" { reporter = "agent" }

	// build the submission JSON body
	body := "{\"message\":" + json(msg)
	body = body + ",\"app\":\"machin-secure\""
	body = body + ",\"version\":\"" + version + "\""
	body = body + ",\"kind\":" + json(kind)
	body = body + ",\"context\":" + json(ctx)
	body = body + ",\"reporter\":" + json(reporter)
	body = body + ",\"id\":" + json(id)
	body = body + "}"

	relay := env("FEEDBACK_RELAY")
	if relay == "" { relay = "https://feedback.intrane.fr" }

	relayed := false
	if relay != "off" {
		resp := https_post(relay + "/v1/feedback", body)
		if resp != "" { relayed = true }
	}

	out := "{\"ok\":true,\"id\":" + json(id) + ",\"relayed\":" + str(bool_to_int(relayed)) + "}"
	println(out)
}

func bool_to_int(b) (n) {
	n = 0
	if b { n = 1 }
}

// ---- arg parsing ----

func main() {
	a := args()

	if len(a) > 1 && a[1] == "verdict" {
		cmd_verdict(a)
		return
	}

	if len(a) > 1 && a[1] == "suppress" {
		cmd_suppress(a)
		return
	}

	if len(a) > 1 && a[1] == "guide" {
		cmd_guide(a)
		return
	}

	if len(a) > 1 && a[1] == "feedback" {
		cmd_feedback(a)
		return
	}

	target := ""
	rules_path := "rules.json"
	want_hart := false
	want_summary := false
	want_sarif := false
	hart_owner := "machin-secure"
	hart_artifact := "audit"
	store_path := ""
	patterns_store := ""
	want_diff := false
	diff_base := ""
	workers := 8
	help := false

	i := 1
	for i < len(a) {
		arg := a[i]
		if arg == "--target" { i = i + 1 ; if i < len(a) { target = a[i] } }
		if arg == "--rules" { i = i + 1 ; if i < len(a) { rules_path = a[i] } }
		if arg == "--hart" { want_hart = true }
		if arg == "--summary" { want_summary = true }
		if arg == "--sarif" { want_sarif = true }
		if arg == "--hart-owner" { i = i + 1 ; if i < len(a) { hart_owner = a[i] } }
		if arg == "--hart-artifact" { i = i + 1 ; if i < len(a) { hart_artifact = a[i] } }
		if arg == "--store" { i = i + 1 ; if i < len(a) { store_path = a[i] } }
		if arg == "--patterns-store" { i = i + 1 ; if i < len(a) { patterns_store = a[i] } }
		if arg == "--show-all" { want_show_all = true }
		if arg == "--pending" { want_pending = true }
		if arg == "--diff" { want_diff = true }
		if arg == "--diff-base" { want_diff = true ; i = i + 1 ; if i < len(a) { diff_base = a[i] } }
		if arg == "--workers" { i = i + 1 ; if i < len(a) { workers = parse_int(a[i]) } }
		if arg == "--context" { i = i + 1 ; if i < len(a) { context_n = parse_int(a[i]) } }
		if arg == "--help" || arg == "-h" { help = true }
		if has_prefix(arg, "-") == false && target == "" && i > 0 { target = arg }
		i = i + 1
	}

	if help {
		println("machin-secure — KISS security auditor (agent-first, JSONL output)")
		println("")
		println("usage: secure [OPTIONS] [TARGET]")
		println("       secure verdict --target PATH <id> <keep|drop> [--reason TEXT]")
		println("       secure suppress --target PATH --rule RULE --glob GLOB [--reason TEXT]")
		println("       secure guide [--human]")
		println("       secure feedback \"<message>\" [--kind bug|idea|praise|note] [--context TEXT]")
		println("")
		println("No LLM call is made by this tool. It emits structured findings; the")
		println("calling agent (which already has its own model) reads them, judges them,")
		println("and records its verdict with `secure verdict` so future scans remember it.")
		println("")
		println("options:")
		println("  --target PATH        directory or file to scan (default: current dir)")
		println("  --rules PATH         rules.json (default: ./rules.json)")
		println("  --summary            print only a summary JSON object, no per-finding lines")
		println("  --sarif              emit a SARIF 2.1.0 report on stdout (for GitHub Code Scanning)")
		println("                       — pipe to a file and upload with github/codeql-action/upload-sarif")
		println("  --show-all           include findings the agent already marked 'drop'")
		println("  --pending            emit only unreviewed findings (verdict == \"\") — the agent's")
		println("                       work queue. Excludes both 'keep' (reviewed) and 'drop'")
		println("                       (suppressed). Combine with --diff-base for PR-scoped triage.")
		println("  --store PATH         verdict store (default: <target-dir>/.machin-secure.verdicts.json)")
		println("  --patterns-store PATH suppression pattern store (default: <target-dir>/.machin-secure.patterns.json)")
		println("                       — patterns are filed via `secure suppress` and suppress findings")
		println("                       by (rule, glob) at scan time, so the agent triages a pattern once,")
		println("                       not 30 individual findings. See `secure suppress --help`.")
		println("  --diff               scan only files changed in the working tree (git diff --name-only)")
		println("  --diff-base REF      scan only files changed vs REF (git diff --name-only REF...HEAD),")
		println("                       for CI/PR-scoped scans; implies --diff. Target must be a git repo.")
		println("  --workers N          parallel scan workers for a full directory walk (default: 8)")
		println("  --context N          include N lines of code before and after each finding as")
		println("                       ctx_before / ctx_after arrays, so the calling agent can")
		println("                       triage without a separate read_file round-trip (default: 0)")
		println("  --hart               print guidance for publishing your own HTML report to")
		println("                       hart.intrane.fr (default instance). This tool does not")
		println("                       author or publish the report — your own model does,")
		println("                       using `hart publish`. See https://hart.intrane.fr/llms.txt")
		println("  --hart-owner NAME    suggested hart owner namespace (default: machin-secure)")
		println("  --hart-artifact NAME suggested hart artifact slug (default: audit)")
		println("  --help, -h           this help")
		println("")
		println("output: one JSON finding per line on stdout (JSONL). Each finding has a")
		println("stable \"id\" — pass it to `secure verdict` to keep or drop it.")
		println("exit:   0 = clean, 1 = error, 2 = high/critical findings present")
		println("")
		println("subcommands:")
		println("  secure guide [--human]   the embedded agent skill (cli-guide-spec): model,")
		println("                          loop, concepts, commands, examples, gotchas")
		println("  secure feedback \"<msg>\"  send feedback to the maintainer (cli-feedback-spec)")
		println("                          — best-effort, never fails. FEEDBACK_RELAY=off to disable")
		return
	}

	if target == "" { target = "." }

	rules := load_rules(rules_path)
	if len(rules) == 0 {
		println("{\"error\":\"no rules loaded from " + rules_path + "\"}")
		exit(1)
	}

	if store_path == "" { store_path = default_store_path(target) }
	load_verdicts(store_path)
	if patterns_store == "" { patterns_store = default_patterns_path(target) }
	load_patterns(patterns_store)

	run.target = target
	run.started = now_ms()
	run.rules_n = len(rules)

	k, _, _ := stat(target)
	if k == 0 {
		println("{\"error\":\"target not found: " + target + "\"}")
		exit(1)
	}
	if want_diff {
		if k != 2 {
			println("{\"error\":\"--diff requires a directory target (a git repo root)\"}")
			exit(1)
		}
		diff_scan(target, diff_base, rules)
	} else if k == 1 {
		lang := lang_of(target)
		if lang != "" { scan_file(target, lang, rules) }
	} else {
		parallel_walk(target, rules, workers)
	}

	if want_sarif {
		emit_sarif(rules)
	} else if want_summary {
		emit_summary()
	} else {
		emit_jsonl()
	}

	if want_hart {
		art := hart_artifact + "-" + str(now_ms())
		print_hart_hint(hart_owner, art)
	}

	has_high := false
	for _, f := range run.findings {
		if f.severity == "critical" || f.severity == "high" { has_high = true }
	}
	if has_high { exit(2) }
	exit(0)
}
