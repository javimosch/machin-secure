// machin-secure — KISS security auditor for agent-first use.
// Deterministic regex rules over a filesystem walk. No LLM, no Docker, no agents,
// and — deliberately — no OpenAI/OpenRouter client baked in. The calling agent
// IS the LLM: it reads the JSONL findings with its own model and reasons over
// them directly. The only thing this tool owns is a small persisted verdict
// store (`secure verdict ...`) so the agent's judgment survives across scans,
// the same BYOK split used in ~/ai/grepapi (rules/briefs here, no LLM call;
// the operator's own model completes the reasoning).
// Output: JSONL findings on stdout (one per line). Exit 2 if high/critical, else 0.
// --hart: publish a self-contained HTML report to https://hart.intrane.fr.

type Rule struct {
	id       string
	pattern  string
	severity string
	cwe      string
	message  string
	langs    []string
}

type Finding struct {
	id       string
	rule     string
	file     string
	line     int
	severity string
	cwe      string
	message  string
	snippet  string
	verdict  string
}

type Run struct {
	target     string
	started    int
	findings   []Finding
	scanned    int
	skipped    int
	suppressed int
	rules_n    int
}

// verdict record persisted by `secure verdict` — written by the calling agent
// after IT (not this tool) decides a finding is a false positive or confirmed.
type VerdictRec struct {
	id      string
	verdict string
	reason  string
	ts      int
}

// a file queued for scanning, and one worker's local (never-shared) tally —
// per machin's data-race rule, only the collector goroutine (main) may ever
// touch the `run` global; workers accumulate into their own WorkerResult and
// hand it over a channel once, after their job queue drains.
type Job struct {
	path string
	lang string
}

type WorkerResult struct {
	findings   []Finding
	scanned    int
	skipped    int
	suppressed int
}

// global run state (structs are pass-by-value in MFL; a global avoids copying)
var run = Run{findings: []Finding{}}
var verdict_map = make(map[string]string)
var want_show_all = false
// lang -> applicable rules, built once per distinct lang instead of once per
// file (avoids re-walking all rules for every one of tens of thousands of files)
var lang_rules_cache = make(map[string][]Rule)

// ---- helpers ----

func last_index(s, sub) (n) {
	n = -1
	j := 0
	for j < len(s)-len(sub)+1 {
		if substr(s, j, j+len(sub)) == sub { n = j }
		j = j + 1
	}
}

// ---- lang detection by extension ----

func lang_of(path) (lang) {
	lang = ""
	bi := last_index(path, "/")
	base := substr(path, bi+1, len(path))
	// Dockerfile (no extension)
	if base == "Dockerfile" || has_prefix(base, "Dockerfile.") { lang = "dockerfile" ; return }
	if has_prefix(base, ".env") { lang = "env" ; return }
	i := last_index(path, ".")
	if i < 0 { return }
	ext := substr(path, i+1, len(path))
	if ext == "py" { lang = "py" ; return }
	if ext == "js" || ext == "cjs" || ext == "mjs" { lang = "js" ; return }
	if ext == "ts" { lang = "ts" ; return }
	if ext == "tsx" { lang = "tsx" ; return }
	if ext == "jsx" { lang = "jsx" ; return }
	if ext == "vue" { lang = "vue" ; return }
	if ext == "go" { lang = "go" ; return }
	if ext == "php" { lang = "php" ; return }
	if ext == "rb" { lang = "rb" ; return }
	if ext == "java" { lang = "java" ; return }
	if ext == "sh" { lang = "sh" ; return }
	if ext == "yml" || ext == "yaml" { lang = "yaml" ; return }
	if ext == "json" { lang = "json" ; return }
	if ext == "md" { lang = "md" ; return }
}

// ---- dir skip list ----

func should_skip_dir(name) (b) {
	b = false
	skip := []string{".git", "node_modules", ".venv", "venv", "__pycache__", "dist", "build", "coverage", ".next", ".nuxt", ".cache", "vendor", ".idea", ".vscode", "target", "deps", ".hg", ".svn"}
	for _, s := range skip {
		if s == name { b = true ; return }
	}
}

// ---- verdict store (the agent's persisted memory, not this tool's) ----

func default_store_path(target) (path) {
	k, _, _ := stat(target)
	dir := target
	if k == 1 {
		bi := last_index(target, "/")
		dir = "."
		if bi >= 0 { dir = substr(target, 0, bi) }
	}
	path = dir + "/.machin-secure.verdicts.json"
}

func load_verdict_recs(path) (recs) {
	recs = []VerdictRec{}
	s := read_file(path)
	if len(s) == 0 { return }
	recs = parse(s, []VerdictRec{})
}

func load_verdicts(path) {
	recs := load_verdict_recs(path)
	for _, r := range recs { verdict_map[r.id] = r.verdict }
}

func save_verdict(path, id, verdict, reason) {
	recs := load_verdict_recs(path)
	out := []VerdictRec{}
	found := false
	for _, r := range recs {
		if r.id == id {
			r.verdict = verdict
			r.reason = reason
			r.ts = now()
			found = true
		}
		out = append(out, r)
	}
	if !found {
		out = append(out, VerdictRec{id: id, verdict: verdict, reason: reason, ts: now()})
	}
	write_file(path, json(out))
}

// ---- rule loading ----

func load_rules(path) (rules) {
	rules = []Rule{}
	s := read_file(path)
	if len(s) == 0 { return }
	rules = parse(s, []Rule{})
}

// ---- rule applies to lang? ----

func rule_applies(rule, lang) (b) {
	b = false
	for _, rl := range rule.langs {
		if rl == "*" { b = true ; return }
		if rl == lang { b = true ; return }
	}
}

// ---- file scan ----

// pre-filter rules to those applicable to a lang, cached: with tens of
// thousands of files but only a dozen or so distinct langs, this turns
// O(files x rules) filtering into O(distinct-langs x rules).
func rules_for_lang(rules, lang) (out) {
	if has(lang_rules_cache, lang) { out = lang_rules_cache[lang] ; return }
	out = []Rule{}
	for _, rule := range rules {
		if rule_applies(rule, lang) { out = append(out, rule) }
	}
	lang_rules_cache[lang] = out
}

func scan_file(path, lang, rules) {
	run.scanned = run.scanned + 1
	src := read_file(path)
	if len(src) == 0 { return }
	if len(src) > 1000000 { run.skipped = run.skipped + 1 ; return }
	applicable := rules_for_lang(rules, lang)
	if len(applicable) == 0 { return }
	lines := split(src, "\n")
	for i, line := range lines {
		trimmed := trim(line)
		if trimmed == "" { continue }
		for _, rule := range applicable {
			if regex_match(line, rule.pattern) {
				id := sha256(rule.id + "|" + path + "|" + trimmed)
				v := verdict_map[id]
				if v == "drop" {
					run.suppressed = run.suppressed + 1
					if !want_show_all { continue }
				}
				snip := trimmed
				if len(snip) > 200 { snip = substr(snip, 0, 200) + "..." }
				f := Finding{
					id:       id,
					rule:     rule.id,
					file:     path,
					line:     i + 1,
					severity: rule.severity,
					cwe:      rule.cwe,
					message:  rule.message,
					snippet:  snip,
					verdict:  v,
				}
				run.findings = append(run.findings, f)
			}
		}
	}
}

// ---- diff mode: scan only git-changed files, for fast CI/pre-commit checks ----
// `--diff` alone: working-tree changes vs HEAD (local dev, pre-commit).
// `--diff-base <ref>`: changes vs a base branch/commit (CI, PR diff), using
// git's triple-dot (merge-base) form so unrelated upstream commits on the
// base don't show up as "changed".

func diff_scan(target, base, rules) {
	cmd := "git -C " + target + " diff --name-only"
	if base != "" { cmd = cmd + " " + base + "...HEAD" }
	code, out, errout := exec(cmd)
	if code != 0 {
		println("{\"error\":\"git diff failed: " + trim(errout) + "\"}")
		exit(1)
	}
	paths := split(out, "\n")
	for _, p := range paths {
		rel := trim(p)
		if rel == "" { continue }
		full := target + "/" + rel
		k, size, _ := stat(full)
		if k != 1 { continue }  // deleted/renamed-away files won't stat as a file
		if has_suffix(rel, ".machin-secure.verdicts.json") { continue }
		if size > 1000000 { run.skipped = run.skipped + 1 ; continue }
		lang := lang_of(full)
		if lang == "" { continue }
		scan_file(full, lang, rules)
	}
}

// ---- recursive walk: collect jobs, then scan them in parallel ----
// Walking (list_dir/stat) is cheap and stays single-threaded; the expensive
// part — reading each file and running every applicable regex over every
// line — is what gets spread across worker goroutines below.

func collect_files(dir, depth) (jobs) {
	jobs = []Job{}
	if depth > 25 { return }
	entries := list_dir(dir)
	for _, name := range entries {
		full := dir + "/" + name
		k, size, _ := stat(full)
		if k == 2 {
			if should_skip_dir(name) { continue }
			sub := collect_files(full, depth+1)
			for _, j := range sub { jobs = append(jobs, j) }
		} else if k == 1 {
			if has_suffix(name, ".machin-secure.verdicts.json") { continue }
			if size > 1000000 { run.skipped = run.skipped + 1 ; continue }
			lang := lang_of(full)
			if lang == "" { continue }
			jobs = append(jobs, Job{path: full, lang: lang})
		}
	}
}

// every lang lang_of() can return; precomputing all of them once (instead of
// lazily per-file, per the old lang_rules_cache global) means no worker ever
// writes to a shared map — each just reads its own entry, which is race-free.
func all_langs() (langs) {
	langs = []string{"py", "js", "ts", "tsx", "jsx", "vue", "go", "php", "rb", "java", "sh", "yaml", "json", "env", "md", "dockerfile"}
}

func build_lang_rules_index(rules) (idx) {
	idx = make(map[string][]Rule)
	for _, l := range all_langs() {
		out := []Rule{}
		for _, rule := range rules {
			if rule_applies(rule, l) { out = append(out, rule) }
		}
		idx[l] = out
	}
}

// scan_into is scan_file's logic against a WORKER-LOCAL result instead of
// the `run` global — safe to call from any number of goroutines at once
// because it never touches shared mutable state (lang_rules is a read-only
// map built before any worker starts; verdict_map/want_show_all are globals
// populated/set before spawning and never written again during a scan).
func scan_into(path, lang, lang_rules, wr_in) (wr) {
	wr = wr_in
	wr.scanned = wr.scanned + 1
	src := read_file(path)
	if len(src) == 0 { return }
	if len(src) > 1000000 { wr.skipped = wr.skipped + 1 ; return }
	applicable := lang_rules[lang]
	if len(applicable) == 0 { return }
	lines := split(src, "\n")
	for i, line := range lines {
		trimmed := trim(line)
		if trimmed == "" { continue }
		for _, rule := range applicable {
			if regex_match(line, rule.pattern) {
				id := sha256(rule.id + "|" + path + "|" + trimmed)
				v := verdict_map[id]
				if v == "drop" {
					wr.suppressed = wr.suppressed + 1
					if !want_show_all { continue }
				}
				snip := trimmed
				if len(snip) > 200 { snip = substr(snip, 0, 200) + "..." }
				f := Finding{
					id:       id,
					rule:     rule.id,
					file:     path,
					line:     i + 1,
					severity: rule.severity,
					cwe:      rule.cwe,
					message:  rule.message,
					snippet:  snip,
					verdict:  v,
				}
				wr.findings = append(wr.findings, f)
			}
		}
	}
}

func scan_worker(jobs, lang_rules, results) {
	wr := WorkerResult{findings: []Finding{}}
	for job := range jobs {
		wr = scan_into(job.path, job.lang, lang_rules, wr)
	}
	results <- wr
}

func parallel_walk(target, rules, workers) {
	jobs_list := collect_files(target, 0)
	n := len(jobs_list)
	if n == 0 { return }
	if workers > n { workers = n }
	if workers < 1 { workers = 1 }
	lang_rules := build_lang_rules_index(rules)

	jobs := make(chan Job)
	results := make(chan WorkerResult)
	w := 0
	for w < workers { go scan_worker(jobs, lang_rules, results) ; w = w + 1 }
	i := 0
	for i < n { jobs <- jobs_list[i] ; i = i + 1 }
	close(jobs)

	got := 0
	for got < workers {
		wr := <-results
		for _, f := range wr.findings { run.findings = append(run.findings, f) }
		run.scanned = run.scanned + wr.scanned
		run.skipped = run.skipped + wr.skipped
		run.suppressed = run.suppressed + wr.suppressed
		got = got + 1
	}
}

// ---- output ----

func emit_jsonl() {
	for _, f := range run.findings {
		println(json(f))
	}
}

func emit_summary() {
	crit := 0 ; high := 0 ; med := 0 ; low := 0
	for _, f := range run.findings {
		if f.severity == "critical" { crit = crit + 1 }
		if f.severity == "high" { high = high + 1 }
		if f.severity == "medium" { med = med + 1 }
		if f.severity == "low" { low = low + 1 }
	}
	m := make(map[string]int)
	m["critical"] = crit
	m["high"] = high
	m["medium"] = med
	m["low"] = low
	m["total"] = crit + high + med + low
	m["scanned"] = run.scanned
	m["skipped"] = run.skipped
	m["suppressed"] = run.suppressed
	m["rules"] = run.rules_n
	println(json(m))
}

// ---- hart reporting (opt-in) ----
// This tool deliberately does NOT author the report itself — that would bake
// another piece of "LLM-flavored" judgment (what to highlight, how to phrase
// it) into a binary that otherwise owns none. Same rule as the verdict store:
// the calling agent already has a model; authoring prose/HTML is its job.
// --hart only prints a hint pointing the agent at the default hart instance
// and the exact publish contract, so it can write and publish its own report.

func print_hart_hint(owner, artifact) {
	hart_url := env("HART_URL")
	if hart_url == "" { hart_url = "https://hart.intrane.fr" }
	crit := 0 ; high := 0 ; med := 0 ; low := 0
	for _, f := range run.findings {
		if f.severity == "critical" { crit = crit + 1 }
		if f.severity == "high" { high = high + 1 }
		if f.severity == "medium" { med = med + 1 }
		if f.severity == "low" { low = low + 1 }
	}
	hint := "Write a self-contained HTML report of these findings (target="
	hint = hint + run.target + ", " + str(crit) + " critical, " + str(high) + " high, "
	hint = hint + str(med) + " medium, " + str(low) + " low) and publish it yourself: "
	hint = hint + "HART_URL=" + hart_url + " hart publish <file.html> --owner " + owner
	hint = hint + " --artifact " + artifact + " --visibility unlisted"
	m := make(map[string]string)
	m["hart_hint"] = hint
	m["hart_url"] = hart_url
	m["hart_guide"] = hart_url + "/llms.txt"
	m["note"] = "machin-secure does not generate or publish reports itself; this is guidance for the calling agent's own model"
	println(json(m))
}

// ---- verdict subcommand ----
// `secure verdict` never reasons about a finding itself — it only persists a
// verdict the calling agent already decided. The agent is the LLM here; this
// tool has no model client, no API key, no network call to any LLM provider.

func print_verdict_help() {
	println("usage: secure verdict --target PATH <id> <keep|drop> [--reason TEXT]")
	println("       secure verdict --target PATH --stdin")
	println("")
	println("Persists the CALLING AGENT's own judgment about a finding id (from the")
	println("\"id\" field of a JSONL finding), so a future scan of the same target")
	println("suppresses it (verdict=drop) or marks it reviewed (verdict=keep).")
	println("This tool never calls an LLM to decide this itself.")
	println("")
	println("--stdin reads JSON Lines of {\"id\":...,\"verdict\":\"keep\"|\"drop\",\"reason\":...}")
	println("for batch review after the agent has read a scan's output.")
	println("")
	println("store: <target-dir>/.machin-secure.verdicts.json (override with --store PATH)")
}

func cmd_verdict(a) {
	target := "."
	store_path := ""
	use_stdin := false
	id := ""
	verdict := ""
	reason := ""
	help := false

	i := 2
	for i < len(a) {
		arg := a[i]
		if arg == "--target" { i = i + 1 ; if i < len(a) { target = a[i] } }
		if arg == "--store" { i = i + 1 ; if i < len(a) { store_path = a[i] } }
		if arg == "--reason" { i = i + 1 ; if i < len(a) { reason = a[i] } }
		if arg == "--stdin" { use_stdin = true }
		if arg == "--help" || arg == "-h" { help = true }
		if !has_prefix(arg, "-") {
			if id == "" { id = arg } else if verdict == "" { verdict = arg }
		}
		i = i + 1
	}

	if help {
		print_verdict_help()
		return
	}

	if store_path == "" { store_path = default_store_path(target) }

	if use_stdin {
		s := read_stdin()
		lines := split(s, "\n")
		n := 0
		for _, line := range lines {
			t := trim(line)
			if t == "" { continue }
			rec := parse(t, VerdictRec{})
			if rec.id == "" || rec.verdict == "" { continue }
			save_verdict(store_path, rec.id, rec.verdict, rec.reason)
			n = n + 1
		}
		println("{\"stored\":" + str(n) + ",\"store\":\"" + store_path + "\"}")
		exit(0)
	}

	if id == "" || verdict == "" {
		println("{\"error\":\"usage: secure verdict --target PATH <id> <keep|drop> [--reason TEXT]\"}")
		exit(1)
	}
	if verdict != "keep" && verdict != "drop" {
		println("{\"error\":\"verdict must be 'keep' or 'drop'\"}")
		exit(1)
	}
	save_verdict(store_path, id, verdict, reason)
	println("{\"stored\":1,\"id\":\"" + id + "\",\"verdict\":\"" + verdict + "\",\"store\":\"" + store_path + "\"}")
	exit(0)
}

// ---- arg parsing ----

func main() {
	a := args()

	if len(a) > 1 && a[1] == "verdict" {
		cmd_verdict(a)
		return
	}

	target := ""
	rules_path := "rules.json"
	want_hart := false
	want_summary := false
	hart_owner := "machin-secure"
	hart_artifact := "audit"
	store_path := ""
	want_diff := false
	diff_base := ""
	workers := 8
	help := false

	i := 1
	for i < len(a) {
		arg := a[i]
		if arg == "--target" { i = i + 1 ; if i < len(a) { target = a[i] } }
		if arg == "--rules" { i = i + 1 ; if i < len(a) { rules_path = a[i] } }
		if arg == "--hart" { want_hart = true }
		if arg == "--summary" { want_summary = true }
		if arg == "--hart-owner" { i = i + 1 ; if i < len(a) { hart_owner = a[i] } }
		if arg == "--hart-artifact" { i = i + 1 ; if i < len(a) { hart_artifact = a[i] } }
		if arg == "--store" { i = i + 1 ; if i < len(a) { store_path = a[i] } }
		if arg == "--show-all" { want_show_all = true }
		if arg == "--diff" { want_diff = true }
		if arg == "--diff-base" { want_diff = true ; i = i + 1 ; if i < len(a) { diff_base = a[i] } }
		if arg == "--workers" { i = i + 1 ; if i < len(a) { workers = parse_int(a[i]) } }
		if arg == "--help" || arg == "-h" { help = true }
		if has_prefix(arg, "-") == false && target == "" && i > 0 { target = arg }
		i = i + 1
	}

	if help {
		println("machin-secure — KISS security auditor (agent-first, JSONL output)")
		println("")
		println("usage: secure [OPTIONS] [TARGET]")
		println("       secure verdict --target PATH <id> <keep|drop> [--reason TEXT]")
		println("")
		println("No LLM call is made by this tool. It emits structured findings; the")
		println("calling agent (which already has its own model) reads them, judges them,")
		println("and records its verdict with `secure verdict` so future scans remember it.")
		println("")
		println("options:")
		println("  --target PATH        directory or file to scan (default: current dir)")
		println("  --rules PATH         rules.json (default: ./rules.json)")
		println("  --summary            print only a summary JSON object, no per-finding lines")
		println("  --show-all           include findings the agent already marked 'drop'")
		println("  --store PATH         verdict store (default: <target-dir>/.machin-secure.verdicts.json)")
		println("  --diff               scan only files changed in the working tree (git diff --name-only)")
		println("  --diff-base REF      scan only files changed vs REF (git diff --name-only REF...HEAD),")
		println("                       for CI/PR-scoped scans; implies --diff. Target must be a git repo.")
		println("  --workers N          parallel scan workers for a full directory walk (default: 8)")
		println("  --hart               print guidance for publishing your own HTML report to")
		println("                       hart.intrane.fr (default instance). This tool does not")
		println("                       author or publish the report — your own model does,")
		println("                       using `hart publish`. See https://hart.intrane.fr/llms.txt")
		println("  --hart-owner NAME    suggested hart owner namespace (default: machin-secure)")
		println("  --hart-artifact NAME suggested hart artifact slug (default: audit)")
		println("  --help, -h           this help")
		println("")
		println("output: one JSON finding per line on stdout (JSONL). Each finding has a")
		println("stable \"id\" — pass it to `secure verdict` to keep or drop it.")
		println("exit:   0 = clean, 1 = error, 2 = high/critical findings present")
		return
	}

	if target == "" { target = "." }

	rules := load_rules(rules_path)
	if len(rules) == 0 {
		println("{\"error\":\"no rules loaded from " + rules_path + "\"}")
		exit(1)
	}

	if store_path == "" { store_path = default_store_path(target) }
	load_verdicts(store_path)

	run.target = target
	run.started = now_ms()
	run.rules_n = len(rules)

	k, _, _ := stat(target)
	if k == 0 {
		println("{\"error\":\"target not found: " + target + "\"}")
		exit(1)
	}
	if want_diff {
		if k != 2 {
			println("{\"error\":\"--diff requires a directory target (a git repo root)\"}")
			exit(1)
		}
		diff_scan(target, diff_base, rules)
	} else if k == 1 {
		lang := lang_of(target)
		if lang != "" { scan_file(target, lang, rules) }
	} else {
		parallel_walk(target, rules, workers)
	}

	if want_summary {
		emit_summary()
	} else {
		emit_jsonl()
	}

	if want_hart {
		art := hart_artifact + "-" + str(now_ms())
		print_hart_hint(hart_owner, art)
	}

	has_high := false
	for _, f := range run.findings {
		if f.severity == "critical" || f.severity == "high" { has_high = true }
	}
	if has_high { exit(2) }
	exit(0)
}
